# ============================================================
# Math helpers
# ============================================================
 
def quaternion_to_euler(qx, qy, qz, qw):
    """Same conversion as the MATLAB version (ZYX / aerospace convention)."""
    sinr_cosp = 2 * (qw * qx + qy * qz)
    cosr_cosp = 1 - 2 * (qx * qx + qy * qy)
    roll = np.arctan2(sinr_cosp, cosr_cosp)
 
    sinp = 2 * (qw * qy - qz * qx)
    if abs(sinp) >= 1:
        pitch = np.copysign(np.pi / 2, sinp)
    else:
        pitch = np.arcsin(sinp)
 
    siny_cosp = 2 * (qw * qz + qx * qy)
    cosy_cosp = 1 - 2 * (qy * qy + qz * qz)
    yaw = np.arctan2(siny_cosp, cosy_cosp)
 
    return np.degrees(roll), np.degrees(pitch), np.degrees(yaw)
 
 
def wrap_angle_180(a):
    return np.mod(np.asarray(a) + 180.0, 360.0) - 180.0
 
 
def make_valid_name(name):
    """Loose equivalent of MATLAB's matlab.lang.makeValidName -- keeps
    Python dict keys simple and predictable."""
    valid = "".join(ch if (ch.isalnum() or ch == '_') else '_' for ch in name)
    if valid and valid[0].isdigit():
        valid = "_" + valid
    return valid or "_unnamed"
 
 
# ============================================================
# Per-body raw data buffer (Python lists grow fine on their own --
# no pre-allocation/doubling trick needed like in MATLAB)
# ============================================================
 
class RigidBodyBuffer:
    def __init__(self):
        self.time = []
        self.position = []
        self.quaternion = []
        self.euler = []
 
    def append_row(self, t, position_mm, quat, euler):
        self.time.append(t)
        self.position.append(position_mm)
        self.quaternion.append(quat)
        self.euler.append(euler)
 
    def append_nan_row(self, t):
        self.time.append(t)
        self.position.append([np.nan, np.nan, np.nan])
        self.quaternion.append([np.nan, np.nan, np.nan, np.nan])
        self.euler.append([np.nan, np.nan, np.nan])
 
    def trim(self):
        return {
            'Position': np.array(self.position, dtype=float).reshape(-1, 3),
            'Quaternion': np.array(self.quaternion, dtype=float).reshape(-1, 4),
            'Euler': np.array(self.euler, dtype=float).reshape(-1, 3),
            'Time': np.array(self.time, dtype=float).reshape(-1, 1),
        }
 
 
# ============================================================
# Robot identification -- matches ONLY "robot" in the name,
# "base" alone does not qualify (same rule as the MATLAB version)
# ============================================================
 
def identify_robot_body(names):
    matches = [n for n in names if 'robot' in n.lower()]
    if len(matches) == 1:
        return matches[0]
    elif len(matches) > 1:
        print(f'WARNING: Multiple Rigid Bodies matched "robot" ({matches}). '
              f'Using the first: {matches[0]}')
        return matches[0]
    return None
 
 
# ============================================================
# Kinematics
# ============================================================
 
def compute_kinematics(original_data):
    kinematics = {}
    for name, body in original_data.items():
        t = body['Time'].flatten()
        pos = body['Position']
        eul = body['Euler']
        n = len(t)
 
        vel = np.full_like(pos, np.nan)
        acc = np.full_like(pos, np.nan)
        ang_vel = np.full_like(eul, np.nan)
 
        if n >= 2:
            dt = np.diff(t)
            dt[dt <= 0] = np.nan
            vel[1:, :] = np.diff(pos, axis=0) / dt[:, None]
            ang_vel[1:, :] = np.diff(eul, axis=0) / dt[:, None]
        if n >= 3:
            dt2 = np.diff(t[1:])
            dt2[dt2 <= 0] = np.nan
            acc[2:, :] = np.diff(vel[1:, :], axis=0) / dt2[:, None]
 
        kinematics[name] = {
            'Velocity': vel,
            'Acceleration': acc,
            'AngularVelocity': ang_vel,
        }
    return kinematics
 
 
# ============================================================
# Relative motion / safety
# ============================================================
 
def compute_relative_motion(original_data, kinematics, robot_name,
                             danger_mm, warn_mm, min_approach_speed):
    result = {'HumanNames': []}
    if robot_name is None or robot_name not in original_data:
        return result
 
    robot_pos = original_data[robot_name]['Position']
    robot_euler = original_data[robot_name]['Euler']
    robot_vel = kinematics[robot_name]['Velocity']
 
    human_names = [n for n in original_data.keys() if n != robot_name]
    n_frames = robot_pos.shape[0]
    n_human = len(human_names)
 
    distance_matrix = np.full((n_frames, n_human), np.nan)
    robot_approach = np.zeros((n_frames, n_human), dtype=bool)
    human_approach = np.zeros((n_frames, n_human), dtype=bool)
 
    for h, hn in enumerate(human_names):
        human_pos = original_data[hn]['Position']
        human_vel = kinematics[hn]['Velocity']
        if human_pos.shape[0] != n_frames:
            continue  # should not happen given NaN-fill alignment, but guard anyway
 
        delta = human_pos - robot_pos           # robot -> human
        dist = np.sqrt(np.sum(delta ** 2, axis=1))
        distance_matrix[:, h] = dist
 
        with np.errstate(invalid='ignore', divide='ignore'):
            dir_unit = delta / dist[:, None]
 
        world_bearing = np.degrees(np.arctan2(delta[:, 1], delta[:, 0]))
        relative_bearing = wrap_angle_180(world_bearing - robot_euler[:, 2])
 
        robot_toward_speed = np.sum(robot_vel * dir_unit, axis=1)
        human_toward_speed = np.sum(human_vel * (-dir_unit), axis=1)
 
        robot_approach[:, h] = robot_toward_speed > min_approach_speed
        human_approach[:, h] = human_toward_speed > min_approach_speed
 
        result[hn] = {'Distance': dist, 'Direction': relative_bearing}
 
    min_dist = np.full(n_frames, np.nan)
    min_idx = np.full(n_frames, -1, dtype=int)
    valid_rows = ~np.all(np.isnan(distance_matrix), axis=1)
    min_dist[valid_rows] = np.nanmin(distance_matrix[valid_rows, :], axis=1)
    min_idx[valid_rows] = np.nanargmin(distance_matrix[valid_rows, :], axis=1)
 
    safety_level = np.zeros(n_frames)
    safety_level[min_dist <= warn_mm] = 1
    safety_level[min_dist <= danger_mm] = 2
    safety_level[np.isnan(min_dist)] = np.nan
 
    min_dist_source = [''] * n_frames
    for f in range(n_frames):
        if min_idx[f] >= 0:
            min_dist_source[f] = human_names[min_idx[f]]
 
    result['MinDistance'] = min_dist
    result['MinDistanceSource'] = min_dist_source
    result['SafetyLevel'] = safety_level
    result['RobotApproaching'] = robot_approach
    result['HumanApproaching'] = human_approach
    result['HumanNames'] = human_names
    result['Thresholds'] = {
        'DangerMM': danger_mm, 'WarningMM': warn_mm,
        'MinApproachSpeed_mmps': min_approach_speed,
    }
    return result
 
 
# ============================================================
# Tracking quality
# ============================================================
 
def find_gap_runs(is_tracked, t):
    runs = []
    n = len(is_tracked)
    i = 0
    while i < n:
        if not is_tracked[i]:
            j = i
            while j < n and not is_tracked[j]:
                j += 1
            last_idx = min(j, n - 1)
            runs.append({'start_idx': i, 'end_idx': j - 1,
                         'duration': t[last_idx] - t[i]})
            i = j
        else:
            i += 1
    return runs
 
 
def compute_tracking_quality(original_data):
    quality = {}
    for name, body in original_data.items():
        is_tracked = ~np.any(np.isnan(body['Position']), axis=1)
        t = body['Time'].flatten()
        gap_runs = find_gap_runs(is_tracked, t)
        quality[name] = {
            'IsTracked': is_tracked,
            'GapCount': len(gap_runs),
            'MaxGapDuration': max((g['duration'] for g in gap_runs), default=0.0),
        }
    return quality
 
 
# ============================================================
# Static body detection (note-only -- raw data is never removed)
# ============================================================
 
def detect_static_bodies(original_data, pos_range_mm, euler_range_deg):
    static_bodies = {}
    for name, body in original_data.items():
        valid_rows = ~np.any(np.isnan(body['Position']), axis=1)
        if not np.any(valid_rows):
            static_bodies[name] = {
                'Classification': 'NeverTracked',
                'Note': ('This Rigid Body was selected but was never successfully '
                         'tracked during this session (no valid data recorded).'),
                'ReferencePosition': np.full(3, np.nan),
                'ReferenceQuaternion': np.full(4, np.nan),
            }
            continue
 
        pos_range = (np.max(body['Position'][valid_rows], axis=0) -
                     np.min(body['Position'][valid_rows], axis=0))
        eul_range = (np.max(body['Euler'][valid_rows], axis=0) -
                     np.min(body['Euler'][valid_rows], axis=0))
 
        if np.all(pos_range <= pos_range_mm) and np.all(eul_range <= euler_range_deg):
            first_valid = int(np.argmax(valid_rows))
            static_bodies[name] = {
                'Classification': 'Static',
                'Note': ('This Rigid Body was tracked but showed no meaningful '
                         'movement during this session (static/reference object).'),
                'ReferencePosition': body['Position'][first_valid],
                'ReferenceQuaternion': body['Quaternion'][first_valid],
            }
        # Dynamic bodies get no entry here -- full data stays in OriginalData.
    return static_bodies
 
 
# ============================================================
# Latency
# ============================================================
 
def compute_latency_stats(loop_timestamps):
    loop_timestamps = np.asarray(loop_timestamps, dtype=float)
    if len(loop_timestamps) < 2:
        return {'InterFrameDt': np.array([]), 'MeanDt': np.nan,
                'MaxDt': np.nan, 'StdDt': np.nan}
    dt = np.diff(loop_timestamps)
    return {'InterFrameDt': dt, 'MeanDt': float(np.mean(dt)),
            'MaxDt': float(np.max(dt)), 'StdDt': float(np.std(dt))}
 
 
