def find_latest_session():
    dirs = [d for d in SESSIONS_DIR.iterdir() if d.is_dir() and d.name.startswith("session_")]
    if not dirs:
        return None
    return max(dirs, key=lambda x: x.stat().st_mtime)


def file_size_mb(p):
    try:
        return os.path.getsize(p) / (1024 * 1024)
    except Exception:
        return 0.0


def md5_of_file(p):
    try:
        h = hashlib.md5()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(8192), b""):
                h.update(chunk)
        return h.hexdigest()[:12]
    except Exception:
        return "N/A"


def count_agents():
    agents = []
    for f in AGENTS_DIR.glob("*.py"):
        if f.name.startswith("_") or f.name == "__init__.py":
            continue
        agents.append({"name": f.name, "lines": sum(1 for _ in open(f, "r", encoding="utf-8", errors="ignore")), "md5": md5_of_file(f)})
    return sorted(agents, key=lambda x: x["lines"], reverse=True)


def read_memory_status():
    mem = {}
    for f in MEMORY_DIR.glob("*"):
        if f.is_file():
            mem[f.name] = {"size_mb": round(file_size_mb(f), 3), "modified": datetime.fromtimestamp(f.stat().st_mtime).strftime("%Y-%m-%d %H:%M")}
    return mem


def check_modalities(session_dir):
    mods = {"motive": False, "slam": False, "robot_cmd": False, "robot_odom": False, "video": False, "cross_modal": False, "entity": False, "safety": False}
    for f in session_dir.rglob("*"):
        n = f.name.lower()
        if f.suffix == ".pkl":
            if "motive" in n: mods["motive"] = True
            if "slam" in n: mods["slam"] = True
            if "command" in n or "cmd" in n: mods["robot_cmd"] = True
        if f.suffix == ".csv":
            if "motive" in n or "natnet" in n: mods["motive"] = True
            if "slam" in n or "lidar" in n: mods["slam"] = True
            if "cmd" in n or "command" in n: mods["robot_cmd"] = True
            if "odom" in n: mods["robot_odom"] = True
        if f.suffix in [".json", ".jsonl"]:
            if "cross_modal" in n or "alignment" in n: mods["cross_modal"] = True
            if "entity" in n or "registry" in n: mods["entity"] = True
            if "safety" in n: mods["safety"] = True
        if f.suffix in [".mp4", ".avi", ".mkv"]:
            mods["video"] = True
    return mods


def analyze_videos(session_dir):
    videos = []
    for ext in [".mp4", ".avi", ".mkv"]:
        videos.extend(session_dir.rglob("*" + ext))
    results = []
    for v in videos:
        info = {"name": v.name, "size_mb": round(file_size_mb(v), 1)}
        try:
            import cv2
            cap = cv2.VideoCapture(str(v))
            if cap.isOpened():
                info["resolution"] = "%dx%d" % (int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)), int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)))
                info["fps"] = round(cap.get(cv2.CAP_PROP_FPS), 1)
                info["frames"] = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
                info["duration_s"] = round(info["frames"] / max(info["fps"], 1), 1)
                brightness = []
                for frac in [0.25, 0.5, 0.75]:
                    cap.set(cv2.CAP_PROP_POS_FRAMES, int(frac * info["frames"]))
                    ret, frame = cap.read()
                    if ret:
                        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                        brightness.append(float(gray.mean()))
                if brightness:
                    info["avg_brightness"] = round(sum(brightness) / len(brightness), 1)
                cap.release()
        except ImportError:
            info["note"] = "OpenCV unavailable"
        results.append(info)
    return results


def run_sub_agent(agent_name, session_name):
    agent_path = AGENTS_DIR / agent_name
    if not agent_path.exists():
        return {"agent": agent_name, "status": "NOT_FOUND", "output": ""}
    try:
        cmd = [sys.executable, str(agent_path)]
        if session_name:
            if agent_name == "run_session_analysis.py":
                cmd.append(os.path.join("sessions", session_name))
            else:
                cmd.append(session_name)
        proc = subprocess.run(cmd, input="all\n", capture_output=True, text=True, timeout=180, cwd=str(PROJECT_ROOT), encoding="utf-8", errors="replace")
        return {"agent": agent_name, "status": "OK" if proc.returncode == 0 else "ERROR", "output": proc.stdout[-2000:] if proc.stdout else "", "errors": proc.stderr[-500:] if proc.stderr else ""}
    except subprocess.TimeoutExpired:
        return {"agent": agent_name, "status": "TIMEOUT", "output": ""}
    except Exception as e:
        return {"agent": agent_name, "status": "EXCEPTION", "output": str(e)}


def score_session(mods, videos, session_dir):
    score = 0
    issues = []
    strengths = []
    if mods["motive"]:
        score += 20
        strengths.append("Motive data present")
    else:
        issues.append("CRITICAL: No Motive data")
    if mods["robot_cmd"]:
        score += 20
        strengths.append("Robot commands (Action col) present")
    else:
        issues.append("CRITICAL: No robot commands")
    if mods["video"]:
        score += 15
        strengths.append("Video recorded")
        dark = [v for v in videos if v.get("avg_brightness", 100) < 40]
        if dark:
            issues.append("WARNING: %d dark video(s)" % len(dark))
        else:
            score += 5
            strengths.append("Video brightness OK")
    else:
        issues.append("CRITICAL: No video")
    if mods["slam"]:
        score += 10
        strengths.append("SLAM data present")
    else:
        issues.append("MINOR: No SLAM data")
    if mods["safety"]:
        score += 10
        strengths.append("Safety events logged")
    else:
        issues.append("WARNING: No safety events")
    if mods["cross_modal"]:
        score += 10
        strengths.append("Cross-modal aligned")
    else:
        issues.append("MINOR: No cross-modal alignment")
    if mods["entity"]:
        score += 5
        strengths.append("Entity registry active")
    if mods["robot_odom"]:
        score += 5
        strengths.append("Odometry logged")

    has_critical = any("CRITICAL" in i for i in issues)
    paper_ready = score >= 65 and not has_critical
    grade = "A" if score >= 80 else "B" if score >= 65 else "C" if score >= 50 else "D" if score >= 30 else "F"
    return {"score": score, "grade": grade, "paper_ready": paper_ready, "issues": issues, "strengths": strengths}


def compare_with_big_tech(mods, videos):
    my_cameras = len(videos) if videos else 0
    my_res = videos[0].get("resolution", "N/A") if videos else "N/A"
    my_fps = videos[0].get("fps", 0) if videos else 0
    my_mods = sum(1 for v in mods.values() if v)
    my_sessions = len([d for d in SESSIONS_DIR.iterdir() if d.is_dir() and d.name.startswith("session_")])

    rows = []
    rows.append("| Dimension | You | Tesla | Google RT-X | Berkeley DROID |")
    rows.append("|---|---|---|---|---|")
    rows.append("| Cameras | %d | 8 | 1 | 3 |" % my_cameras)
    rows.append("| Resolution | %s | 1280x960 | varies | 1080p |" % my_res)
    rows.append("| FPS | %s | 36 | 5-30 | 15 |" % my_fps)
    rows.append("| Modalities | %d/8 | 8 | 22 | 5 |" % my_mods)
    rows.append("| Sessions | %d | 10M+ | 1M+ | 350K |" % my_sessions)
    rows.append("| Cross-Modal | %s | 100%% | 100%% | 100%% |" % ("YES" if mods["cross_modal"] else "NO"))
    rows.append("| Action Col | %s | 100%% | 100%% | 100%% |" % ("YES" if mods["robot_cmd"] else "NO"))
    rows.append("| Safety | %s | auto | auto | manual |" % ("YES" if mods["safety"] else "NO"))
    return "\n".join(rows)


def self_analysis(agents, mem_status, assessment):
    lines = []
    lines.append("### Agent Count: %d" % len(agents))
    active = len([a for a in agents if a["lines"] > 50])
    lines.append("  Active (>50 lines): %d" % active)
    lines.append("")
    lines.append("### Memory Health:")
    for name, info in mem_status.items():
        lines.append("  %s: %.3f MB (updated %s)" % (name, info["size_mb"], info["modified"]))
    lines.append("")
    lines.append("### Gap Analysis:")
    if assessment["score"] < 65:
        lines.append("  - Score %d/100 is below Paper-Ready threshold (65)" % assessment["score"])
    if not assessment["paper_ready"]:
        lines.append("  - NOT Paper-Ready yet")
    for issue in assessment["issues"]:
        if "CRITICAL" in issue:
            lines.append("  - %s" % issue)
    return "\n".join(lines)


def recommend_next_steps(mods, assessment, session_name):
    steps = []
    priority = 1
    if not mods["robot_cmd"]:
        steps.append("%d. [CRITICAL] Verify MirCommandLogger is active in launch_session.py" % priority)
        steps.append("   Run: python agents/launch_session.py and check for [MirCmdLogger] output")
        priority += 1
    if not mods["video"]:
        steps.append("%d. [CRITICAL] Export video from Motive to session folder" % priority)
        priority += 1
    if not mods["cross_modal"]:
        steps.append("%d. [HIGH] Run cross-modal alignment" % priority)
        steps.append("   Run: python agents/cross_modal_aligner.py %s" % session_name)
        priority += 1
    if not mods["safety"]:
        steps.append("%d. [HIGH] Record safety interaction scenarios" % priority)
        steps.append("   Walk in front of robot, place obstacles, do close passes")
        priority += 1
    if not mods["slam"]:
        steps.append("%d. [MEDIUM] Enable SLAM logging" % priority)
        priority += 1
    if assessment["score"] >= 65:
        steps.append("%d. [MEDIUM] Start VLA dataset formatting" % priority)
        steps.append("   Build vla_dataset_builder.py for QwenVLA input")
        priority += 1
    steps.append("%d. [LOW] Archive obsolete agents" % priority)
    steps.append("   entity_surgery.py, merge_entities.py, fix_all.py, fix_syntax_surgical.py")
    return "\n".join(steps)


def generate_roadmap(assessment):
    lines = []
    lines.append("### Roadmap to First Paper-Ready Session")
    lines.append("")
    if assessment["score"] < 30:
        lines.append("Phase 1: Foundation (Current)")
        lines.append("  [ ] Fix all CRITICAL modality gaps")
        lines.append("  [ ] Record 3+ sessions with full VLA columns")
        lines.append("  [ ] Target score: 50+")
    elif assessment["score"] < 65:
        lines.append("Phase 2: Quality (Current)")
        lines.append("  [ ] Fix remaining modality gaps")
        lines.append("  [ ] Run cross-modal alignment on all sessions")
        lines.append("  [ ] Add safety event scenarios")
        lines.append("  [ ] Target score: 65+")
    elif assessment["score"] < 80:
        lines.append("Phase 3: Paper Preparation (Current)")
        lines.append("  [ ] Annotate videos (CVAT)")
        lines.append("  [ ] Build VLA dataset")
        lines.append("  [ ] Run QwenVLA fine-tuning")
        lines.append("  [ ] Target score: 80+")
    else:
        lines.append("Phase 4: Publication (Current)")
        lines.append("  [x] Paper-Ready achieved!")
        lines.append("  [ ] Write paper draft")
        lines.append("  [ ] Submit to conference")
    return "\n".join(lines)


