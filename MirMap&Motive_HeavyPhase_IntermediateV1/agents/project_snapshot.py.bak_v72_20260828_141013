import json, pickle, os, re, hashlib, sys
from datetime import datetime, timezone
from pathlib import Path

if hasattr(sys.stdout, 'reconfigure'):
    try: sys.stdout.reconfigure(encoding='utf-8', errors='backslashreplace')
    except: pass

WS = Path(__file__).resolve().parent.parent
AGENTS = WS / "agents"
SESSIONS = WS / "sessions"
MOTIVE_SESS = WS / "motive sessions"
PK_DIR = WS / "persistent_knowledge"
REPORTS_DIR = WS / "reports"
ARCHIVE = WS / "archive"
RPT_MD = WS / "MASTER_REPORT.md"
RPT_JSON = WS / "MASTER_REPORT.json"

ROADMAP_STEPS = [
    {"id":1,"name":"Zero Placeholder Filter","evidence":[("contains","agents/spatial_temporal_fusion.py","zero_placeholder")]},
    {"id":2,"name":"Human-in-Loop Merge","evidence":[("path","agents/apply_merge.py"),("contains","agents/knowledge_engine.py","SAFE")]},
    {"id":3,"name":"Persistent Label Registry","evidence":[("path","persistent_knowledge/label_registry.pkl")]},
    {"id":4,"name":"SLAM Map Annotator","evidence":[("path","agents/slam_map_annotator.py")]},
    {"id":5,"name":"CVAT Video Annotation","evidence":[("path","agents/cvat_converter.py"),("path","agents/auto_labeler.py")]},
    {"id":6,"name":"Cross-Modal Aligner","evidence":[("path","agents/cross_modal_aligner.py")]},
    {"id":7,"name":"Unified Session Report","evidence":[("contains","agents/run_session_analysis.py","session_comprehensive_report")]},
    {"id":8,"name":"Robot Action / Odom Logger","evidence":[("path","agents/mir_command_logger.py")]},
    {"id":9,"name":"SLAM-to-BEV Renderer","evidence":[("path","agents/slam_to_bev.py")]},
    {"id":10,"name":"VLA Video Narrator","evidence":[("path","agents/video_narrator.py")]},
]

BIG_TECH_PRACTICES = {
    "Human-in-loop (Figure AI)": ("agents/apply_merge.py", "CRITICAL"),
    "SAFE mode (never auto-merge)": ("agents/knowledge_engine.py", "CRITICAL"),
    "Atomic saves": ("agents/knowledge_engine.py", "HIGH"),
    "External annotation (CVAT)": ("agents/cvat_converter.py", "HIGH"),
    "Cross-modal alignment": ("agents/cross_modal_aligner.py", "MEDIUM"),
    "Persistent label registry": ("persistent_knowledge/label_registry.pkl", "HIGH"),
    "BEV Vision Tokenizer (Tesla/Waymo)": ("agents/slam_to_bev.py", "HIGH"),
    "Language-Action Grounding (RT-2/Qwen)": ("agents/video_narrator.py", "HIGH"),
}

class SnapshotV72:
    def __init__(self):
        self.ts = datetime.now(tz=timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        self.prior = self._load_prior()

    def _load_prior(self):
        if RPT_JSON.exists():
            try: return json.load(open(RPT_JSON, encoding="utf-8"))
            except: pass
        return None

    def audit_agents(self):
        active = {}
        if AGENTS.exists():
            for f in AGENTS.glob("*.py"):
                try:
                    src = open(f, encoding="utf-8", errors="ignore").read()
                    lines = len(src.splitlines())
                    sha = hashlib.sha256(src.encode()).hexdigest()[:16]
                    funcs = len(re.findall(r"^\s*def\s+", src, re.MULTILINE))
                    classes = len(re.findall(r"^\s*class\s+", src, re.MULTILINE))
                    tools = []
                    for t, p in [("ROS","roslibpy"),("OpenCV","cv2"),("NumPy","numpy"),("PyTorch","torch"),("SciPy","scipy"),("SKLearn","sklearn")]:
                        if re.search(p, src, re.IGNORECASE): tools.append(t)
                    active[f.name] = {"lines":lines,"kb":round(f.stat().st_size/1024,2),"sha":sha,"funcs":funcs,"classes":classes,"tools":tools}
                except: pass
        archived = len(list(ARCHIVE.glob("*.py"))) if ARCHIVE.exists() else 0
        return {"active_count":len(active),"archived_count":archived,"active":active}

    def audit_sessions(self):
        sessions, actions, vla_data, ke_data = {}, {}, {}, {}
        if not SESSIONS.exists(): return sessions, actions, vla_data, ke_data
        for sd in sorted(SESSIONS.iterdir()):
            if not sd.is_dir() or not sd.name.startswith("session_"): continue
            n = sd.name
            has_mocap = (sd/"motive_data.pkl").exists()
            has_slam = (sd/"slam_data.pkl").exists()
            
            # Action Audit
            vla_info = {"has_cmds":False,"action_source":"none","total":0,"nonzero":0,"density":0.0,"freq_hz":0.0,"duration_s":0.0,"max_linear":0.0,"max_angular":0.0,"braking_events":0,"safety_events":0}
            cmd_file = sd / "mir_command_data.pkl"
            if cmd_file.exists():
                try:
                    data = pickle.load(open(cmd_file,"rb"))
                    odom = data.get("odom_log",[])
                    cmd = data.get("cmd_vel_log",[])
                    stream = cmd if (isinstance(cmd,list) and len(cmd)>0) else odom
                    vla_info["action_source"] = "cmd_vel" if (isinstance(cmd,list) and len(cmd)>0) else ("odom_actual" if len(odom)>0 else "none")
                    if stream:
                        vla_info["has_cmds"] = True
                        vla_info["total"] = len(stream)
                        for e in stream:
                            lx = abs(float(e.get("actual_linear_x_mps",0) or e.get("linear_x",0) or 0))
                            az = abs(float(e.get("actual_angular_z_rps",0) or e.get("angular_z",0) or 0))
                            if lx>0.005 or az>0.005: vla_info["nonzero"] += 1
                            if lx>vla_info["max_linear"]: vla_info["max_linear"] = round(lx,3)
                            if az>vla_info["max_angular"]: vla_info["max_angular"] = round(az,3)
                        vla_info["density"] = round(vla_info["nonzero"]/vla_info["total"]*100,1)
                        if "start_time_utc" in data and "end_time_utc" in data:
                            from datetime import datetime as dt
                            t0 = dt.fromisoformat(str(data["start_time_utc"]).replace("Z","+00:00"))
                            t1 = dt.fromisoformat(str(data["end_time_utc"]).replace("Z","+00:00"))
                            vla_info["duration_s"] = round((t1-t0).total_seconds(),1)
                            if vla_info["duration_s"]>0: vla_info["freq_hz"] = round(vla_info["total"]/vla_info["duration_s"],1)
                except: pass

            vla_data[n] = vla_info
            has_cmd = vla_info["has_cmds"]
            has_fusion = (sd/"fused_data.pkl").exists() and (sd/"fused_data.pkl").stat().st_size > 1000
            vid_sub = list((sd/"video").glob("*")) if (sd/"video").exists() else []
            vid_mot = list(MOTIVE_SESS.glob(f"{n}*")) if MOTIVE_SESS.exists() else []
            has_video = len(vid_sub)>0 or len(vid_mot)>0
            
            score = int(sum([has_mocap, has_slam, has_cmd, has_video, has_fusion]) / 5 * 100)
            sessions[n] = {"mocap":has_mocap,"slam":has_slam,"cmd":has_cmd,"video":has_video,"fusion":has_fusion,"score":score}
            actions[n] = {"total":vla_info["total"],"nonzero":vla_info["nonzero"],"density":vla_info["density"]}
        return sessions, actions, vla_data

    def evaluate_roadmap(self):
        results = []
        for step in ROADMAP_STEPS:
            passed = 0
            for kind, path, *args in step["evidence"]:
                fp = WS / path
                if kind == "path" and fp.exists(): passed += 1
                elif kind == "contains" and fp.exists():
                    try:
                        if args[0] in open(fp, encoding="utf-8", errors="ignore").read(): passed += 1
                    except: pass
            total = len(step["evidence"])
            status = "DONE" if passed==total else ("PARTIAL" if passed>0 else "PENDING")
            results.append({"id":step["id"],"name":step["name"],"status":status,"evidence":f"{passed}/{total}"})
        return results

    def big_tech_check(self):
        results = {}
        for name, (path, imp) in BIG_TECH_PRACTICES.items():
            fp = WS / path
            results[name] = {"status":"PRESENT" if fp.exists() else "MISSING","importance":imp}
        present = sum(1 for r in results.values() if r["status"]=="PRESENT")
        return results, present, len(results)

    def run(self):
        print(f"[{self.ts}] Snapshot v7.2 Running...")
        agents = self.audit_agents()
        sessions, actions, vla_data = self.audit_sessions()
        roadmap = self.evaluate_roadmap()
        bt, bt_present, bt_total = self.big_tech_check()
        
        # Paper Readiness Score
        n = len(sessions)
        sc_mod = sum(s["score"] for s in sessions.values()) / n / 100 * 25 if n else 0
        sc_act = sum(1 for a in actions.values() if a["total"] > 0) / n * 20 if n else 0
        sc_moc = sum(1 for s in sessions.values() if s["mocap"]) / n * 15 if n else 0
        sc_fus = sum(1 for s in sessions.values() if s["fusion"]) / n * 15 if n else 0
        sc_vid = sum(1 for s in sessions.values() if s["video"]) / n * 10 if n else 0
        sc_bt = (bt_present / bt_total if bt_total else 0) * 15
        score = round(sc_mod + sc_act + sc_moc + sc_fus + sc_vid + sc_bt, 1)
        grade = "A" if score>=85 else "B" if score>=70 else "C" if score>=50 else "D" if score>=35 else "F"
        
        total_cmds = sum(v["total"] for v in vla_data.values())
        
        # Markdown Report Output
        md = [f"# MASTER REPORT v7.2 (Master Brain)", f"**Generated:** {self.ts} | **Operator:** Kiarash Amiri | **PoliTo**\n"]
        md.append(f"## 1. PAPER READINESS: {score}/100 ({grade})")
        md.append(f"Sessions: {n} | Action Samples: {total_cmds} | Big Tech Alignment: {bt_present}/{bt_total} ({round(bt_present/bt_total*100)}%)\n")
        
        md.append("## 2. ROADMAP EXECUTION (100% Evidence-Based)")
        for r in roadmap:
            ck = "x" if r["status"]=="DONE" else ("~" if r["status"]=="PARTIAL" else " ")
            md.append(f"- [{ck}] **Step {r['id']}:** {r['name']} ({r['evidence']}) [{r['status']}]")
        md.append("")
        
        md.append("## 3. BIG TECH PRACTICES")
        for name, r in bt.items(): md.append(f"- **{name}:** {r['status']} ({r['importance']})")
        md.append("")

        report_text = "\n".join(md)
        with open(RPT_MD,"w",encoding="utf-8") as f: f.write(report_text)
        with open(REPORTS_DIR/"latest_snapshot_for_ai.md","w",encoding="utf-8") as f: f.write(report_text)
        
        print(f"[OK] v7.2 Finished | Readiness Score: {score}/100 ({grade}) | Big Tech: {bt_present}/{bt_total}")

if __name__ == "__main__":
    SnapshotV72().run()
