import cv2
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from datetime import datetime

sys.stdout.reconfigure(encoding="utf-8")

BASE = r"D:\kiarash\kiarash git codes\MirMap&Motive_HeavyPhase_IntermediateV1"
STAMP = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
ARCHIVE_ROOT = os.path.join(BASE, "Visual_Archives")
DESKTOP_ROOT = os.path.join(os.environ["USERPROFILE"], "Desktop", "Kiarash1234")
RUN_NAME = "Run_" + STAMP
RUN = os.path.join(ARCHIVE_ROOT, RUN_NAME)

D1 = os.path.join(RUN, "1_BEV_Frames")
D2 = os.path.join(RUN, "2_YOLO_Detections")
D3 = os.path.join(RUN, "3_SLAM_Maps")
D4 = os.path.join(RUN, "4_Publication_Figures")
D5 = os.path.join(RUN, "5_Decision_Dashboards")
for d in (D1, D2, D3, D4, D5):
    os.makedirs(d, exist_ok=True)

ERR = open(os.path.join(RUN, "ERROR_LOG.txt"), "w", encoding="utf-8")
def log_err(tag):
    ERR.write("### " + tag + "\n" + traceback.format_exc() + "\n\n")
    ERR.flush()
    print("  [FAIL] " + tag + " (details in ERROR_LOG.txt)")

def nfiles(d):
    return len([f for f in glob.glob(os.path.join(d, "*")) if os.path.isfile(f)])

def caption(fig, text):
    fig.text(0.5, -0.04, text, ha="center", fontsize=9, style="italic")

def safeget(fn, default="n/a"):
    try:
        return fn()
    except Exception:
        return default

plt.rcParams.update({
    "font.family": "serif",
    "font.serif": ["Times New Roman", "DejaVu Serif"],
    "font.size": 11,
    "axes.linewidth": 1.0,
    "axes.edgecolor": "black",
    "savefig.dpi": 300,
})
OI = {"blue": "#0072B2", "orange": "#E69F00", "green": "#009E73", "red": "#D55E00",
      "purple": "#CC79A7", "sky": "#56B4E9", "yellow": "#F0E442", "black": "#000000"}
CLS_SHORT = {"FORWARD_CRUISING": "Cruise", "LOW_SPEED_NAVIGATION": "Low-speed",
             "IDLE_STATIONARY": "Idle", "ROTATIONAL_MANEUVER": "Rotation"}
CLS_COLOR = {"FORWARD_CRUISING": OI["blue"], "LOW_SPEED_NAVIGATION": OI["orange"],
             "IDLE_STATIONARY": OI["green"], "ROTATIONAL_MANEUVER": OI["purple"]}

print("=" * 66)
print("PUBLICATION-GRADE VISUAL REPORTER v5.0")
print("RUN: " + RUN)
print("=" * 66)

# ---------------- DISCOVERY ----------------
sessions = sorted(glob.glob(os.path.join(BASE, "sessions", "session_*")))
S = None
for cand in reversed(sessions):
    if os.path.exists(os.path.join(cand, "slam_data.pkl")):
        S = cand
        break
print("[DISCOVERY] session : " + (os.path.basename(S) if S else "NONE"))

bev_pngs = []
if S:
    bev_pngs = sorted(glob.glob(os.path.join(S, "bev_images", "*.png")))
print("[DISCOVERY] BEV     : " + str(len(bev_pngs)) + " frames")

stamp = os.path.basename(S).replace("session_", "") if S else ""
vids = []
motive_dir = os.path.join(BASE, "motive sessions")
if os.path.isdir(motive_dir) and stamp:
    vids = sorted([v for v in glob.glob(os.path.join(motive_dir, "*.avi")) if stamp in os.path.basename(v)])
print("[DISCOVERY] videos  : " + str([os.path.basename(v) for v in vids]))

EVAL = None
HIST = None
try:
    with open(os.path.join(BASE, "eval_results_v3.json"), "r", encoding="utf-8") as f:
        EVAL = json.load(f)
    print("[DISCOVERY] eval    : " + str(len(EVAL.get("p", []))) + " predictions")
except Exception:
    log_err("load eval")
try:
    hp = os.path.join(BASE, "models", "qwen3_vla_mir100_lora_v2", "training_history.json")
    with open(hp, "r", encoding="utf-8") as f:
        HIST = json.load(f)
    print("[DISCOVERY] history : " + str(len(HIST.get("epochs", []))) + " epochs, canary entries: " + str(len(HIST.get("canary", []))))
except Exception:
    log_err("load history")

# ---------------- TABLE 1 ----------------
try:
    if EVAL is None:
        raise RuntimeError("eval not loaded")
    mae_v = EVAL["mae_v"]
    mae_w = EVAL["mae_w"]
    z = EVAL["z_bl"]
    m = EVAL["m_bl"]
    imp_z = (z[0] - mae_v) / z[0] * 100.0
    imp_m = (m[0] - mae_v) / m[0] * 100.0
    col_labels = ["Policy", "MAE_v (m/s)", "MAE_w (rad/s)", "Improvement vs Zero-BL"]
    cell = [
        ["Qwen3-VL-2B + QLoRA (Ours)", "{:.4f}".format(mae_v), "{:.4f}".format(mae_w), "-{:.1f}%".format(imp_z)],
        ["Zero Baseline [0.0, 0.0]", "{:.4f}".format(z[0]), "{:.4f}".format(z[1]), "reference"],
        ["Mean Baseline (train mean)", "{:.4f}".format(m[0]), "{:.4f}".format(m[1]), "-{:.1f}%".format(imp_m)],
    ]
    fig, ax = plt.subplots(figsize=(9.5, 2.8))
    ax.axis("off")
    tbl = ax.table(cellText=cell, colLabels=col_labels, loc="center", cellLoc="center")
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(10)
    tbl.scale(1.0, 2.0)
    for j in range(len(col_labels)):
        tbl[0, j].set_facecolor("#d9d9d9")
        tbl[0, j].set_text_props(fontweight="bold")
        tbl[1, j].set_facecolor("#e8f4e8")
        tbl[1, j].set_text_props(fontweight="bold")
    caption(fig, "Table 1. Validation performance (N=69) vs baselines. Source: eval_results_v3.json.")
    fig.savefig(os.path.join(D4, "Table_1_Performance_Summary.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] Table 1 (MAE_v {:.4f} vs zero-BL {:.4f} -> -{:.1f}%)".format(mae_v, z[0], imp_z))
except Exception:
    log_err("Table 1")

# ---------------- FIGURE 1: LOSS ----------------
try:
    if HIST is None:
        raise RuntimeError("history not loaded")
    ep = [e["epoch"] for e in HIST["epochs"]]
    lo = [e["loss"] for e in HIST["epochs"]]
    fig, ax = plt.subplots(figsize=(6.5, 4.2))
    ax.plot(ep, lo, marker="o", color=OI["blue"], linewidth=2, markersize=7,
            markerfacecolor="white", markeredgewidth=1.8)
    ax.set_yscale("log")
    ax.set_xlabel("Training Epoch")
    ax.set_ylabel("Cross-Entropy Loss (log scale)")
    ax.set_xticks(ep)
    ax.grid(True, which="both", linestyle=":", alpha=0.5)
    ax.text(0.02, 0.97, "(a)", transform=ax.transAxes, fontsize=13, fontweight="bold", va="top")
    for x, y in zip(ep, lo):
        ax.annotate("{:.4f}".format(y), (x, y), textcoords="offset points", xytext=(0, 9), ha="center", fontsize=8)
    caption(fig, "Figure 1. Label-masked QLoRA convergence over 6 epochs. Source: training_history.json [epochs].")
    fig.savefig(os.path.join(D4, "Figure_1_Loss_Curve.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] Figure 1 loss: " + ", ".join("{:.4f}".format(x) for x in lo))
except Exception:
    log_err("Figure 1")

# ---------------- FIGURE 2: CANARY (REAL PER-EPOCH LOGS) ----------------
try:
    if HIST is None:
        raise RuntimeError("history not loaded")
    can = HIST["canary"]
    n_samp = len(can[0]["res"])
    fig, axes = plt.subplots(1, n_samp, figsize=(6.4 * n_samp, 4.4))
    if n_samp == 1:
        axes = [axes]
    letters = "abcdefghijklm"
    for si in range(n_samp):
        ax = axes[si]
        eps = [c["epoch"] for c in can]
        pv = [c["res"][si]["pred"][0] for c in can]
        pw = [c["res"][si]["pred"][1] for c in can]
        gtv = can[-1]["res"][si]["gt"][0]
        gtw = can[-1]["res"][si]["gt"][1]
        ax.plot(eps, pv, "o-", color=OI["blue"], linewidth=2, label="predicted v")
        ax.axhline(gtv, color=OI["blue"], linestyle="--", linewidth=1.4, label="GT v = {:.3f}".format(gtv))
        ax.plot(eps, pw, "s-", color=OI["orange"], linewidth=2, label="predicted w")
        ax.axhline(gtw, color=OI["orange"], linestyle="--", linewidth=1.4, label="GT w = {:.3f}".format(gtw))
        ferr = abs(pv[-1] - gtv) + abs(pw[-1] - gtw)
        ax.set_title("Hard sample #{} (final |err| = {:.3f})".format(si + 1, ferr), fontsize=11)
        ax.set_xlabel("Training Epoch")
        ax.set_ylabel("Action output")
        ax.set_xticks(eps)
        ax.grid(True, linestyle=":", alpha=0.5)
        ax.text(0.02, 0.97, "(" + letters[si] + ")", transform=ax.transAxes, fontsize=13, fontweight="bold", va="top")
        ax.legend(fontsize=8)
    caption(fig, "Figure 2. Live canary-test convergence on held-out hard samples. Source: training_history.json [canary].")
    fig.savefig(os.path.join(D4, "Figure_2_Canary_Convergence.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] Figure 2 ({} canary samples x {} epochs, all real)".format(n_samp, len(can)))
except Exception:
    log_err("Figure 2")

# ---------------- FIGURE 3: SCATTER + R2 ----------------
try:
    if EVAL is None:
        raise RuntimeError("eval not loaded")
    p = EVAL["p"]
    gt_v = np.array([s["gt"][0] for s in p])
    pr_v = np.array([s["pred"][0] for s in p])
    gt_w = np.array([s["gt"][1] for s in p])
    pr_w = np.array([s["pred"][1] for s in p])
    cls = [s["cls"] for s in p]

    def r2(g, q):
        ss_res = float(np.sum((g - q) ** 2))
        ss_tot = float(np.sum((g - np.mean(g)) ** 2))
        if ss_tot <= 0:
            return float("nan")
        return 1.0 - ss_res / ss_tot

    fig, axes = plt.subplots(1, 2, figsize=(11.5, 4.8))
    for ax, g, q, lab, pane in ((axes[0], gt_v, pr_v, "linear velocity v (m/s)", "a"),
                                 (axes[1], gt_w, pr_w, "angular velocity w (rad/s)", "b")):
        for c in sorted(set(cls)):
            idx = [i for i in range(len(cls)) if cls[i] == c]
            ax.scatter(g[idx], q[idx], s=36, alpha=0.8, edgecolors="black", linewidths=0.6,
                       color=CLS_COLOR.get(c, OI["black"]),
                       label=CLS_SHORT.get(c, c) + " (n={})".format(len(idx)))
        lo_l = min(float(np.min(g)), float(np.min(q))) - 0.05
        hi_l = max(float(np.max(g)), float(np.max(q))) + 0.05
        ax.plot([lo_l, hi_l], [lo_l, hi_l], "--", color=OI["red"], linewidth=1.3, label="ideal 1:1")
        ax.set_xlabel("Ground truth " + lab)
        ax.set_ylabel("Predicted " + lab)
        mae = float(np.mean(np.abs(g - q)))
        ax.set_title("({}) MAE = {:.4f} | R2 = {:.3f}".format(pane, mae, r2(g, q)), fontsize=11)
        ax.grid(True, linestyle=":", alpha=0.5)
        ax.legend(fontsize=8)
    caption(fig, "Figure 3. Predicted vs ground-truth actions on validation set (N=69), colored by behavior class. Source: eval_results_v3.json [p].")
    fig.savefig(os.path.join(D4, "Figure_3_GT_vs_Pred_Scatter.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] Figure 3 (R2_v={:.3f}, R2_w={:.3f})".format(r2(gt_v, pr_v), r2(gt_w, pr_w)))
except Exception:
    log_err("Figure 3")

# ---------------- FIGURE 4: BEHAVIORAL MAE ----------------
try:
    if EVAL is None:
        raise RuntimeError("eval not loaded")
    groups = {}
    for s in EVAL["p"]:
        groups.setdefault(s["cls"], []).append(s)
    order = sorted(groups.keys(), key=lambda c: -len(groups[c]))
    names = [CLS_SHORT.get(c, c) + "\n(n=" + str(len(groups[c])) + ")" for c in order]
    mv = [float(np.mean([abs(s["gt"][0] - s["pred"][0]) for s in groups[c]])) for c in order]
    mw = [float(np.mean([abs(s["gt"][1] - s["pred"][1]) for s in groups[c]])) for c in order]
    x = np.arange(len(order))
    w = 0.38
    fig, ax = plt.subplots(figsize=(8, 4.6))
    ax.bar(x - w / 2, mv, w, color=OI["blue"], edgecolor="black", linewidth=0.6, label="MAE_v (m/s)")
    ax.bar(x + w / 2, mw, w, color=OI["orange"], edgecolor="black", linewidth=0.6, label="MAE_w (rad/s)")
    for xi in range(len(order)):
        ax.text(x[xi] - w / 2, mv[xi] + 0.004, "{:.3f}".format(mv[xi]), ha="center", fontsize=8)
        ax.text(x[xi] + w / 2, mw[xi] + 0.004, "{:.3f}".format(mw[xi]), ha="center", fontsize=8)
    ax.set_xticks(x)
    ax.set_xticklabels(names, fontsize=10)
    ax.set_ylabel("Mean Absolute Error")
    ax.grid(True, axis="y", linestyle=":", alpha=0.5)
    ax.legend()
    caption(fig, "Figure 4. Error decomposition by behavior class, computed from the 69 validation predictions. Source: eval_results_v3.json [p][cls].")
    fig.savefig(os.path.join(D4, "Figure_4_Behavioral_MAE.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] Figure 4 classes: " + str({CLS_SHORT.get(c, c): len(groups[c]) for c in order}))
except Exception:
    log_err("Figure 4")

# ---------------- FIGURE 5: CHAIN-OF-THOUGHT ----------------
try:
    if EVAL is None:
        raise RuntimeError("eval not loaded")
    seen = {}
    for s in EVAL["p"]:
        if s["cls"] not in seen:
            seen[s["cls"]] = s
    picks = list(seen.values())[:4]
    n = len(picks)
    fig, axes = plt.subplots(n, 1, figsize=(10, 2.8 * n))
    if n == 1:
        axes = [axes]
    for k in range(n):
        ax = axes[k]
        s = picks[k]
        raw = s.get("raw", "")
        th = re.search(r"<thought>(.*?)</thought>", raw, re.S)
        ac = re.search(r"<action>(.*?)(</action>|$)", raw, re.S)
        thought = "(no thought tag found)"
        if th:
            thought = textwrap.shorten(th.group(1).replace("\n", " ").strip(), 300, placeholder=" ...")
        action = "(no action tag found)"
        if ac:
            action = textwrap.shorten(ac.group(1).replace("\n", " ").strip(), 150, placeholder=" ...")
        ax.axis("off")
        ax.text(0.0, 0.98, "Class: {}   |   GT = {}   |   Pred = {}".format(
            CLS_SHORT.get(s["cls"], s["cls"]), s["gt"], s["pred"]),
            fontsize=10, fontweight="bold", transform=ax.transAxes, va="top")
        ax.text(0.0, 0.80, "THOUGHT:", fontsize=9, fontweight="bold", transform=ax.transAxes, va="top", color=OI["blue"])
        ax.text(0.0, 0.68, textwrap.fill(thought, 105), fontsize=8.5, transform=ax.transAxes, va="top", family="monospace")
        ax.text(0.0, 0.28, "ACTION:", fontsize=9, fontweight="bold", transform=ax.transAxes, va="top", color=OI["orange"])
        ax.text(0.0, 0.16, textwrap.fill(action, 105), fontsize=8.5, transform=ax.transAxes, va="top", family="monospace")
        ax.text(0.99, 0.98, "({})".format("abcd"[k]), fontsize=13, fontweight="bold", transform=ax.transAxes, va="top", ha="right")
    caption(fig, "Figure 5. Verbatim chain-of-thought outputs of the fine-tuned policy on validation samples. Source: eval_results_v3.json [p][raw].")
    fig.savefig(os.path.join(D4, "Figure_5_CoT_Examples.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] Figure 5 CoT examples: " + ", ".join(CLS_SHORT.get(s["cls"], s["cls"]) for s in picks))
except Exception:
    log_err("Figure 5")

# ---------------- SLAM MAPS ----------------
robot_states = []
map_grid = None
res = 0.05
v = np.array([0.0])
try:
    with open(os.path.join(S, "slam_data.pkl"), "rb") as f:
        slam = pickle.load(f)
    robot_states = slam.get("robot_states", [])
    map_grid = slam.get("map_grid", None)
    meta = slam.get("map_metadata", {}) or {}
    for kk in ("resolution", "res", "resolution_m_per_px"):
        if kk in meta:
            try:
                res = float(meta[kk])
                break
            except Exception:
                pass
    xs = np.array([st["x"] for st in robot_states])
    ys = np.array([st["y"] for st in robot_states])
    ts = np.array([st["timestamp_utc"] for st in robot_states])
    yaw = np.array([float(st.get("yaw", 0.0)) for st in robot_states])
    dtn = np.diff(ts)
    dtn[dtn <= 0] = 1e-6
    v = np.concatenate([[0.0], np.hypot(np.diff(xs), np.diff(ys)) / dtn])
    k = max(3, min(15, len(v) // 20))
    vs = np.convolve(v, np.ones(k) / k, mode="same")

    fig, ax = plt.subplots(figsize=(10, 7))
    if map_grid is not None and np.asarray(map_grid).ndim == 2:
        g = np.asarray(map_grid)
        gh, gw = g.shape
        ax.imshow(g, cmap="gray", origin="lower", extent=(0, gw * res, 0, gh * res), alpha=0.85)
    sc = ax.scatter(xs, ys, c=vs, cmap="turbo", s=12, zorder=3)
    fig.colorbar(sc, ax=ax, label="linear velocity v (m/s)")
    ax.plot(xs[0], ys[0], marker="^", color=OI["green"], markersize=14, zorder=4, label="start")
    ax.plot(xs[-1], ys[-1], marker="s", color=OI["red"], markersize=12, zorder=4, label="end")
    stq = max(1, len(xs) // 30)
    ax.quiver(xs[::stq], ys[::stq], np.cos(yaw[::stq]), np.sin(yaw[::stq]),
              color="deepskyblue", scale=45, width=0.004, alpha=0.85, zorder=3)
    ax.set_xlabel("x (m)")
    ax.set_ylabel("y (m)")
    ax.set_title("MiR100 trajectory over SLAM occupancy grid")
    ax.legend(loc="upper right")
    caption(fig, "Map 1. Robot path colored by speed with heading quivers. Source: slam_data.pkl [robot_states, map_grid].")
    fig.savefig(os.path.join(D3, "Map_1_Trajectory_Velocity.png"), bbox_inches="tight")
    plt.close(fig)

    fig, ax = plt.subplots(figsize=(9, 3.6))
    ax.plot(ts - ts[0], vs, color=OI["blue"], linewidth=1.5)
    ax.set_xlabel("time (s)")
    ax.set_ylabel("v (m/s)")
    ax.set_title("Speed profile (finite differences of SLAM poses, {}-pt moving average)".format(k))
    ax.grid(True, linestyle=":", alpha=0.5)
    caption(fig, "Map 2. Derived speed profile. Source: slam_data.pkl [robot_states].")
    fig.savefig(os.path.join(D3, "Map_2_Speed_Profile.png"), bbox_inches="tight")
    plt.close(fig)
    print("  [OK] SLAM maps ({} robot states, mean v = {:.3f}, max v = {:.3f})".format(
        len(robot_states), float(np.mean(v)), float(np.max(v))))
except Exception:
    log_err("SLAM maps")

# ---------------- MAP 3: ROBOT vs HUMAN ----------------
try:
    fp = os.path.join(S, "fused_data.pkl")
    if os.path.exists(fp):
        with open(fp, "rb") as f:
            fused = pickle.load(f)
        hx = []
        hy = []
        for o in fused.get("fused_objects", []):
            if o.get("source") == "motive" and "kiarash" in str(o.get("object_name", "")).lower():
                pos = o.get("position_mir_frame_m")
                if pos is not None and len(pos) >= 2:
                    hx.append(float(pos[0]))
                    hy.append(float(pos[1]))
        if len(hx) > 10:
            fig, ax = plt.subplots(figsize=(10, 7))
            if map_grid is not None and np.asarray(map_grid).ndim == 2:
                g = np.asarray(map_grid)
                gh, gw = g.shape
                ax.imshow(g, cmap="gray", origin="lower", extent=(0, gw * res, 0, gh * res), alpha=0.85)
            if len(robot_states) > 2:
                rx = [st["x"] for st in robot_states]
                ry = [st["y"] for st in robot_states]
                ax.plot(rx, ry, color=OI["blue"], linewidth=2, label="MiR100 (SLAM)")
            ax.plot(hx, hy, color=OI["purple"], linewidth=2, alpha=0.85,
                    label="human operator (MoCap, {} pts)".format(len(hx)))
            ax.set_xlabel("x (m)")
            ax.set_ylabel("y (m)")
            ax.set_title("Robot-human spatial interaction")
            ax.legend()
            caption(fig, "Map 3. Co-registered robot and human trajectories. Source: slam_data.pkl + fused_data.pkl.")
            fig.savefig(os.path.join(D3, "Map_3_Robot_vs_Human.png"), bbox_inches="tight")
            plt.close(fig)
            print("  [OK] Robot-vs-human map ({} human points)".format(len(hx)))
except Exception:
    log_err("Map 3 human")

# ---------------- BEV FRAMES + MONTAGE ----------------
try:
    if bev_pngs:
        sel = np.linspace(0, len(bev_pngs) - 1, min(20, len(bev_pngs))).astype(int)
        for i in sel:
            shutil.copy2(bev_pngs[i], os.path.join(D1, os.path.basename(bev_pngs[i])))
        msel = np.linspace(0, len(bev_pngs) - 1, min(9, len(bev_pngs))).astype(int)
        fig, axes = plt.subplots(3, 3, figsize=(10, 10.5))
        labs = "abcdefghi"
