# ---------------- YOLO FRAMES (REAL BOXES) ----------------
frames_meta = []
try:
    NPV = 8
    for vid in vids[:2]:
        cap = cv2.VideoCapture(vid)
        total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        if total <= 0:
            cap.release()
            continue
        idxs = np.linspace(0, total - 1, NPV).astype(int)
        tag = os.path.splitext(os.path.basename(vid))[0].replace(" ", "_")[-45:]
        for fi in idxs:
            cap.set(cv2.CAP_PROP_POS_FRAMES, int(fi))
            ok, img = cap.read()
            if ok:
                cv2.imwrite(os.path.join(D2, tag + "_f" + str(int(fi)).zfill(6) + ".jpg"), img)
                frames_meta.append((tag, int(fi), img))
        cap.release()
    yj = glob.glob(os.path.join(S, "yolo*.json")) if S else []
    n_over = 0
    if yj and frames_meta:
        with open(yj[0], "r", encoding="utf-8") as f:
            yd = json.load(f)
        per_frame = {}
        def harvest(fk, dets):
            arr = []
            for d in dets:
                box = None
                lbl = "?"
                conf = 0.0
                if isinstance(d, dict):
                    for kk in ("bbox", "box", "xyxy", "bbox_xyxy"):
                        if kk in d:
                            box = d[kk]
                            break
                    if box is None and "x1" in d:
                        box = [d["x1"], d["y1"], d["x2"], d["y2"]]
                    lbl = str(d.get("label", d.get("class", d.get("name", "?"))))
                    try:
                        conf = float(d.get("conf", d.get("confidence", d.get("score", 0))) or 0)
                    except Exception:
                        conf = 0.0
                if box is not None and len(box) >= 4:
                    try:
                        arr.append(([float(box[0]), float(box[1]), float(box[2]), float(box[3])], lbl, conf))
                    except Exception:
                        pass
            if arr:
                per_frame[fk] = arr
        def walk(node):
            if isinstance(node, dict):
                fk = node.get("frame_index", node.get("frame", node.get("frame_id", node.get("frame_number"))))
                dd = node.get("detections", node.get("boxes", node.get("objects")))
                if fk is not None and dd is not None:
                    harvest(fk, dd)
                    return
                for vv in node.values():
                    walk(vv)
            elif isinstance(node, list):
                for it in node:
                    walk(it)
        walk(yd)
        if per_frame:
            int_keys = [kk for kk in per_frame if str(kk).isdigit()]
            for tag, fi, img in frames_meta:
                dets = per_frame.get(fi)
                if dets is None and int_keys:
                    near = min(int_keys, key=lambda kk: abs(int(kk) - fi))
                    if abs(int(near) - fi) <= 15:
                        dets = per_frame.get(near)
                if not dets:
                    continue
                im = img.copy()
                for (x1, y1, x2, y2), lbl, conf in dets:
                    cv2.rectangle(im, (int(x1), int(y1)), (int(x2), int(y2)), (0, 220, 0), 2)
                    cv2.putText(im, lbl + " " + format(conf, ".2f"), (int(x1), max(15, int(y1) - 6)),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 220, 0), 1)
                cv2.imwrite(os.path.join(D2, "YOLO_" + tag + "_f" + str(fi).zfill(6) + ".jpg"), im)
                n_over += 1
    print("  [OK] YOLO: {} files ({} with real boxes)".format(nfiles(D2), n_over))
except Exception:
    log_err("YOLO")

# ---------------- DASHBOARDS (matplotlib panels) ----------------
try:
    bev_list = sorted(glob.glob(os.path.join(D1, "*.png")))
    if frames_meta and bev_list:
        vm = float(np.mean(v))
        vmax = float(np.max(v))
        mae_v_s = safeget(lambda: "{:.4f}".format(EVAL["mae_v"]))
        mae_w_s = safeget(lambda: "{:.4f}".format(EVAL["mae_w"]))
        zb_v_s = safeget(lambda: "{:.4f}".format(EVAL["z_bl"][0]))
        zb_w_s = safeget(lambda: "{:.4f}".format(EVAL["z_bl"][1]))
        can_pred = safeget(lambda: str(HIST["canary"][-1]["res"][0]["pred"]))
        can_gt = safeget(lambda: str(HIST["canary"][-1]["res"][0]["gt"]))
        n = min(len(frames_meta), 6)
        for i in range(n):
            tag, fi, cam = frames_meta[i]
            bev = cv2.cvtColor(cv2.imread(bev_list[i]), cv2.COLOR_BGR2RGB)
            fig = plt.figure(figsize=(15, 4.4))
            ax1 = fig.add_subplot(1, 3, 1)
            ax1.imshow(cv2.cvtColor(cam, cv2.COLOR_BGR2RGB))
            ax1.set_title("(a) camera | " + tag[-32:], fontsize=9)
            ax1.axis("off")
            ax2 = fig.add_subplot(1, 3, 2)
            ax2.imshow(bev)
            ax2.set_title("(b) semantic BEV input", fontsize=9)
            ax2.axis("off")
            ax3 = fig.add_subplot(1, 3, 3)
            ax3.axis("off")
            info = ("VLA MISSION DASHBOARD\n" + "=" * 40 +
                    "\nvideo frame: #" + str(fi) +
                    "\n\nSession speed stats (SLAM):" +
                    "\n  mean v = " + "{:.3f}".format(vm) + " m/s" +
                    "\n  max  v = " + "{:.3f}".format(vmax) + " m/s" +
                    "\n\nValidation policy metrics:" +
                    "\n  MAE_v = " + mae_v_s + " (zero-BL " + zb_v_s + ")" +
                    "\n  MAE_w = " + mae_w_s + " (zero-BL " + zb_w_s + ")" +
                    "\n\nFinal canary prediction:" +
                    "\n  pred " + can_pred + "  vs GT " + can_gt)
            ax3.text(0.0, 0.97, info, fontsize=8.5, va="top", family="monospace")
            fig.savefig(os.path.join(D5, "dashboard_" + str(i + 1).zfill(2) + ".png"),
                        bbox_inches="tight", dpi=200)
            plt.close(fig)
        print("  [OK] Dashboards: " + str(n))
except Exception:
    log_err("Dashboards")

