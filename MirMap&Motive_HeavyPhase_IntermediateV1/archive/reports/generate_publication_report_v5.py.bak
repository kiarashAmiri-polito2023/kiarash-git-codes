            ax.imshow(img)
            ax.set_title("({}) {}".format(labs[k], os.path.basename(bev_pngs[msel[k]])), fontsize=8)
            ax.axis("off")
        caption(fig, "Figure 6. Semantic BEV inputs, evenly sampled across the session. Source: sessions/*/bev_images.")
        fig.savefig(os.path.join(D4, "Figure_6_BEV_Montage.png"), bbox_inches="tight")
        plt.close(fig)
        print("  [OK] BEV: {} frames copied + 3x3 montage".format(len(sel)))
except Exception:
